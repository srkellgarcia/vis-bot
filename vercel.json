{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/morning",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/night",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/tasks",
      "schedule": "*/10 * * * *"
    }
  ]
}
