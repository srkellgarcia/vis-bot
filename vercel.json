{
  "rewrites": [
    { "source": "/(.*)", "destination": "/server.js" }
  ],
  "crons": [
    {
      "path": "/api/cron/morning",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/night",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/tasks",
      "schedule": "*/10 * * * *"
    }
  ]
}
